# ============================================================
# DocuMind AI — environment configuration (example)
# Copy this file to backend/.env and fill in real values.
#   cp .env.example backend/.env
# NEVER commit the real .env file.
# ============================================================

# ---- LLM provider ----
# Which provider generates answers: "gemini" (free tier) or "openai" (paid).
# Retrieval (/api/retrieve) and the whole test suite work WITHOUT any key.
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=30

# Google Gemini (free tier) — get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ---- Embeddings ----
# "sentence_transformers" = real semantic embeddings (default, needs the ML stack).
# "hash"                  = lightweight deterministic embeddings, no ML download.
#                           Useful for a quick offline demo / diagnostics.
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Retrieval / chunking ----
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# ---- Uploads ----
MAX_UPLOAD_MB=10

# ---- Storage ----
# Where ChromaDB persists vectors and where uploaded files are staged.
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# ---- CORS (comma-separated origins allowed to call the API) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
